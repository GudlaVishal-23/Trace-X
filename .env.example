# TRACE-X Environment Configuration Template
# Copy to .env and adjust variables as needed

# Database Configuration (PostgreSQL 16 + PostGIS)
POSTGRES_USER=tracex_user
POSTGRES_PASSWORD=tracex_secure_pass
POSTGRES_DB=tracex_intelligence
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=postgresql://tracex_user:tracex_secure_pass@localhost:5432/tracex_intelligence

# Redis Hot Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Backend Security & JWT
JWT_SECRET=super_secret_jwt_key_sih2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Models & Perception Paths
YOLO_VEHICLE_WEIGHTS=ai/weights/yolov8s.pt
YOLO_PLATE_WEIGHTS=ai/weights/yolov8n_plate.pt
REID_MODEL_WEIGHTS=ai/weights/osnet_ain_x1_0.pth
OCR_ENGINE=paddleocr
MIN_PLATE_CONFIDENCE=0.50
CONFIRMED_PLATE_CONFIDENCE=0.85

# GIS & Map Config
DEFAULT_MAP_LAT=17.4435
DEFAULT_MAP_LNG=78.4682
DEFAULT_MAP_ZOOM=13
CARTO_API_KEY=cb1_3g6l_1_dfd1ae444e3e6001c52a0eef
TILE_LAYER_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?api_key=cb1_3g6l_1_dfd1ae444e3e6001c52a0eef

# Storage & Evidence
SNAPSHOT_STORAGE_PATH=./data/snapshots
MAX_SNAPSHOT_STORAGE_DAYS=30
