# =====================================================================
# TRACE-X (SIH26127) Environment Configuration Example
# =====================================================================

# Ingestion and storage roots (relative or absolute)
DATA_DIR=data
SAMPLE_VIDEOS_DIR=sample videos

# Video Ingestion & Pipeline Controls
MAX_UPLOAD_MB=500
TARGET_PROCESS_FPS=8
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=600

# Demo Mode (1 = instantaneous playback / pre-seeded fixture cache)
DEMO_MODE=0

# Database & Security
DATABASE_URL=sqlite:///data/tracex.db
JWT_SECRET=sih2026-tracex-secret-key-32chars

# Perception & Domain Logic
MAX_SPEED_KMH=160.0
MIN_PLATE_CONFIDENCE=0.50
CONFIRMED_PLATE_CONFIDENCE=0.85
YOLO_WEIGHTS_PATH=yolov8n.pt
