# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
.venv/
ENV/
env/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Agent Workspace Memory & Internal Rules (Local only)
AGENTS.md
.agents/
.kilo/

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Temporary & Scratch files
scratch/

# Database files (Created & seeded automatically on startup)
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
data/*.sqlite3

# Large Binary Model Weights (Downloaded automatically on first use)
*.pt
*.onnx
*.weights

# Heavy Raw Video Files (Keep directory via .gitkeep)
sample videos/*.mp4
sample videos/*.avi
sample videos/*.mov
sample videos/*.mkv
!sample videos/.gitkeep

# Ingest Uploads (Keep directory structures via .gitkeep)
data/uploads/*.mp4
data/uploads/*.avi
data/uploads/*.mov
data/uploads/*.mkv
data/uploads/annotated/*.mp4
data/uploads/crops/*
!data/uploads/.gitkeep
!data/uploads/annotated/.gitkeep
!data/uploads/crops/.gitkeep

# Private presentations and office documents
*.pptx
*.docx
*.xlsx

# Environment variables
.env
